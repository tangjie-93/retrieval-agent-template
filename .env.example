# To separate your traces from other application
LANGSMITH_PROJECT=retrieval-agent

# The following depend on your selected configuration

# LLM choice:
ANTHROPIC_API_KEY=....
FIREWORKS_API_KEY=...
OPENAI_API_KEY=sk-...
# All demos use this ChatGPT model unless overridden.
OPENAI_MODEL=gpt-4o-mini
# For the official OpenAI API, leave this unset.
# OPENAI_BASE_URL=

# Optional: required only by doc/langchain-ecosystem/examples/07_langsmith.py
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=...

# Retrieval provider

## Elastic cloud:
ELASTICSEARCH_URL=...
ELASTICSEARCH_API_KEY=...

## Elastic local:
ELASTICSEARCH_URL=http://host.docker.internal:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

## Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=...

## Mongo Atlas
MONGODB_URI=... # Full connection string
